# Supabase 配置
# 从 Supabase 项目设置中获取这些值：https://app.supabase.com/project/_/settings/api
# 复制此文件为 .env.local 并填入实际值(docker 部署复制成 .env)

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# GitHub 登录配置（可选）
# 控制是否开启 GitHub OAuth 登录功能
# 可选值: true / false (默认 false)
NEXT_PUBLIC_IS_GITHUB_LOGIN=false

# 本地开发只需要上面的 NEXT_PUBLIC_ 变量。
# 下列 4 项仅放进 GitHub 仓库 Settings → Secrets and variables → Actions，禁止写入 .env 或提交到仓库：
# SUPABASE_URL                  与 NEXT_PUBLIC_SUPABASE_URL 相同
# SUPABASE_SERVICE_ROLE_KEY     Supabase 的 service_role key，权限很高，绝不能公开
# FUND_WATCH_USER_ID            你的 Supabase Authentication 用户 UUID
# SERVERCHAN_SENDKEY            Server酱微信推送 SendKey
